<Window x:Class="KCTools.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KC Tools · Giriş"
        Width="460" Height="380"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        MouseLeftButtonDown="OnDragMove">

    <Border CornerRadius="18" Background="#131a22" BorderBrush="#2a3644" BorderThickness="1"
            Padding="30">
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Width="28" Height="28"
                        Background="Transparent" Foreground="#8b9bb0" BorderThickness="0"
                        FontSize="13" Cursor="Hand" Click="OnCancel"/>
                <TextBlock Text="KC TOOLS" FontSize="19" FontWeight="Bold"
                           Foreground="#2ee6c5" VerticalAlignment="Center"/>
            </DockPanel>

            <TextBlock Text="Lisans girişi" FontSize="22" FontWeight="SemiBold"
                       Foreground="#e6edf3" Margin="0,14,0,4"/>
            <TextBlock Text="Devam etmek için hesabınızla giriş yapın."
                       Foreground="#8b9bb0" FontSize="12.5" TextWrapping="Wrap"/>

            <Border Background="#0e151d" BorderBrush="#24303d" BorderThickness="1"
                    CornerRadius="10" Padding="12" Margin="0,18,0,0">
                <TextBlock x:Name="StatusText" Text="Hazır"
                           Foreground="#e6edf3" FontSize="12.5" TextWrapping="Wrap"/>
            </Border>

            <TextBlock x:Name="UserText" Text="" Foreground="#8b9bb0"
                       FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>

            <Button x:Name="SignInButton" Content="Tarayıcıda Giriş Yap"
                    Height="42" Margin="0,20,0,0"
                    Background="#2ee6c5" Foreground="#05231e" FontWeight="Bold"
                    BorderThickness="0" Cursor="Hand" Click="OnSignIn"/>

            <TextBlock Text="Tarayıcı açılır; giriş sonrası bu pencere otomatik devam eder."
                       Foreground="#64748b" FontSize="11" TextWrapping="Wrap"
                       Margin="0,10,0,0"/>
        </StackPanel>
    </Border>
</Window>
