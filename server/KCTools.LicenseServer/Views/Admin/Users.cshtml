@model System.Collections.Generic.IEnumerable<AppUser>
@{
    ViewData["Title"] = "Kullanıcılar";
    var roles = ViewBag.Roles as System.Collections.Generic.Dictionary<System.Guid, string>
                ?? new System.Collections.Generic.Dictionary<System.Guid, string>();
}

<h1>Kullanıcılar</h1>
<p class="sub">Admin ve Customer hesapları</p>

<div class="panel">
    <h2 style="margin-top:0">Yeni kullanıcı</h2>
    <form method="post" asp-action="CreateUser" class="row">
        @Html.AntiForgeryToken()
        <div><label>E-posta</label><input name="Email" type="email" required /></div>
        <div><label>Parola (min 10)</label><input name="Password" type="password" required minlength="10" /></div>
        <div>
            <label>Rol</label>
            <select name="Role">
                <option value="Customer">Customer</option>
                <option value="Admin">Admin</option>
            </select>
        </div>
        <button type="submit">Oluştur</button>
    </form>
</div>

<div class="panel">
    <table>
        <thead>
        <tr><th>E-posta</th><th>Rol</th><th>Durum</th><th>Son giriş</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>@(roles.TryGetValue(user.Id, out var role) ? role : "—")</td>
                <td>
                    @if (user.IsActive)
                    {
                        <span class="tag ok">aktif</span>
                    }
                    else
                    {
                        <span class="tag bad">devre dışı</span>
                    }
                </td>
                <td>@(user.LastLoginAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                <td>
                    <form method="post" asp-action="ToggleUser">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@user.Id" />
                        <button type="submit" class="small ghost">
                            @(user.IsActive ? "Devre dışı bırak" : "Etkinleştir")
                        </button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
