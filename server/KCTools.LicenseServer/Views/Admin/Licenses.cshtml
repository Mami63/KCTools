@model System.Collections.Generic.IEnumerable<License>
@{
    ViewData["Title"] = "Lisanslar";
}

<h1>Lisanslar</h1>
<p class="sub">Oluştur, süre ver, dondur, iptal et</p>

<div class="panel">
    <h2 style="margin-top:0">Yeni lisans</h2>
    <form method="post" asp-action="CreateLicense" class="row">
        @Html.AntiForgeryToken()
        <div><label>Anahtar (boş = otomatik)</label><input name="Key" placeholder="KC-XXXX-XXXX-XXXX" /></div>
        <div><label>Plan</label><input name="Plan" value="PRO" /></div>
        <div><label>Kredi</label><input name="Credits" type="number" value="100" min="0" /></div>
        <div><label>Gün</label><input name="Days" type="number" value="365" min="1" max="3650" /></div>
        <div><label>Kullanıcı e-postası (opsiyonel)</label><input name="Email" type="email" /></div>
        <button type="submit">Oluştur</button>
    </form>
</div>

<div class="panel">
    <table>
        <thead>
        <tr>
            <th>Anahtar</th><th>Plan</th><th>Kredi</th><th>Bitiş</th><th>Durum</th>
            <th>Kullanıcı</th><th>Cihaz</th><th>İşlemler</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var license in Model)
        {
            var now = System.DateTimeOffset.UtcNow;
            var status = license.IsRevoked ? "iptal"
                : license.IsFrozen ? "donmuş"
                : now > license.EndsAt ? "süre doldu"
                : now < license.StartsAt ? "bekliyor" : "aktif";
            var cls = status == "aktif" ? "ok" : status == "donmuş" || status == "bekliyor" ? "warn" : "bad";

            <tr>
                <td class="mono">@license.Key</td>
                <td>@license.Plan</td>
                <td>@license.Credits</td>
                <td>@license.EndsAt.ToString("yyyy-MM-dd")</td>
                <td><span class="tag @cls">@status</span></td>
                <td>@(license.User?.Email ?? "—")</td>
                <td>@license.Devices.Count(item => item.IsActive) aktif</td>
                <td>
                    <div class="actions">
                        <form method="post" asp-action="Extend" class="row" style="gap:4px">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="Key" value="@license.Key" />
                            <input name="Days" type="number" value="30" min="1" style="width:70px;min-width:70px;padding:4px" />
                            <button type="submit" class="small">Uzat</button>
                        </form>

                        @if (!license.IsFrozen)
                        {
                            <form method="post" asp-action="Freeze">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="key" value="@license.Key" />
                                <button type="submit" class="small ghost">Dondur</button>
                            </form>
                        }
                        else
                        {
                            <form method="post" asp-action="Unfreeze">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="key" value="@license.Key" />
                                <button type="submit" class="small ghost">Aktifleştir</button>
                            </form>
                        }

                        @if (!license.IsRevoked)
                        {
                            <form method="post" asp-action="Revoke" onsubmit="return confirm('Lisans iptal edilsin mi?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="Key" value="@license.Key" />
                                <button type="submit" class="small danger">İptal</button>
                            </form>
                        }
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
