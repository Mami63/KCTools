<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         KC TOOLS · Renk paleti ve tipografi
         Material Design 3 yaklaşımı: katmanlı yüzeyler + tek vurgu rengi
         ============================================================ -->

    <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- Yüzeyler -->
    <Color x:Key="C.Bg.Base">#FF090C11</Color>
    <Color x:Key="C.Bg.TitleBar">#FF0B0F15</Color>
    <Color x:Key="C.Bg.Side">#FF0D121A</Color>
    <Color x:Key="C.Bg.Card">#FF111925</Color>
    <Color x:Key="C.Bg.CardAlt">#FF0E1621</Color>
    <Color x:Key="C.Bg.Field">#FF0A1119</Color>
    <Color x:Key="C.Bg.Elevated">#FF16202D</Color>
    <Color x:Key="C.Bg.Console">#FF05080C</Color>
    <Color x:Key="C.Bg.NavHover">#FF121C27</Color>

    <!-- Kenarlıklar -->
    <Color x:Key="C.Border.Soft">#FF19222E</Color>
    <Color x:Key="C.Border.Default">#FF233040</Color>
    <Color x:Key="C.Border.Strong">#FF2E3D4E</Color>

    <!-- Metin -->
    <Color x:Key="C.Text.Primary">#FFE9F0F8</Color>
    <Color x:Key="C.Text.Secondary">#FFA7B7C9</Color>
    <Color x:Key="C.Text.Muted">#FF6E8094</Color>
    <Color x:Key="C.Text.Dim">#FF4B5A6A</Color>

    <!-- Vurgular -->
    <Color x:Key="C.Accent">#FF2ED9C3</Color>
    <Color x:Key="C.Accent.Dark">#FF18B5A2</Color>
    <Color x:Key="C.Accent.Soft">#FF10302E</Color>
    <Color x:Key="C.Accent.Ink">#FF04191A</Color>
    <Color x:Key="C.Success">#FF35D07F</Color>
    <Color x:Key="C.Warning">#FFF2B33D</Color>
    <Color x:Key="C.Danger">#FFF26D6D</Color>
    <Color x:Key="C.Info">#FF63A8FF</Color>

    <!-- Konsol -->
    <Color x:Key="C.Log.Text">#FFC3D3E3</Color>
    <Color x:Key="C.Log.Time">#FF4E6274</Color>
    <Color x:Key="C.Scroll">#FF27333F</Color>
    <Color x:Key="C.Scroll.Hover">#FF3A4A5A</Color>

    <!-- Fırçalar -->
    <SolidColorBrush x:Key="Brush.Bg.Base" Color="{StaticResource C.Bg.Base}" />
    <SolidColorBrush x:Key="Brush.Bg.TitleBar" Color="{StaticResource C.Bg.TitleBar}" />
    <SolidColorBrush x:Key="Brush.Bg.Side" Color="{StaticResource C.Bg.Side}" />
    <SolidColorBrush x:Key="Brush.Bg.Card" Color="{StaticResource C.Bg.Card}" />
    <SolidColorBrush x:Key="Brush.Bg.CardAlt" Color="{StaticResource C.Bg.CardAlt}" />
    <SolidColorBrush x:Key="Brush.Bg.Field" Color="{StaticResource C.Bg.Field}" />
    <SolidColorBrush x:Key="Brush.Bg.Elevated" Color="{StaticResource C.Bg.Elevated}" />
    <SolidColorBrush x:Key="Brush.Bg.Console" Color="{StaticResource C.Bg.Console}" />
    <SolidColorBrush x:Key="Brush.Bg.NavHover" Color="{StaticResource C.Bg.NavHover}" />

    <SolidColorBrush x:Key="Brush.Border.Soft" Color="{StaticResource C.Border.Soft}" />
    <SolidColorBrush x:Key="Brush.Border.Default" Color="{StaticResource C.Border.Default}" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource C.Border.Strong}" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource C.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource C.Text.Secondary}" />
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="{StaticResource C.Text.Muted}" />
    <SolidColorBrush x:Key="Brush.Text.Dim" Color="{StaticResource C.Text.Dim}" />

    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource C.Accent}" />
    <SolidColorBrush x:Key="Brush.Accent.Dark" Color="{StaticResource C.Accent.Dark}" />
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="{StaticResource C.Accent.Soft}" />
    <SolidColorBrush x:Key="Brush.Accent.Ink" Color="{StaticResource C.Accent.Ink}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource C.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource C.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource C.Danger}" />
    <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource C.Info}" />

    <SolidColorBrush x:Key="Brush.Log.Text" Color="{StaticResource C.Log.Text}" />
    <SolidColorBrush x:Key="Brush.Log.Time" Color="{StaticResource C.Log.Time}" />
    <SolidColorBrush x:Key="Brush.Scroll" Color="{StaticResource C.Scroll}" />
    <SolidColorBrush x:Key="Brush.Scroll.Hover" Color="{StaticResource C.Scroll.Hover}" />

    <!-- Marka gradyanı: teal -> indigo -->
    <LinearGradientBrush x:Key="Brush.Brand.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF3BE8CF" />
        <GradientStop Offset="1" Color="#FF5B8DFF" />
    </LinearGradientBrush>

    <!-- Nav seçili arkaplanı (hafif dikey gradyan) -->
    <LinearGradientBrush x:Key="Brush.Nav.Selected" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#FF133532" />
        <GradientStop Offset="1" Color="#FF0F2026" />
    </LinearGradientBrush>

    <!-- Konsol üst başlığı -->
    <LinearGradientBrush x:Key="Brush.Log.Header" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF0E151E" />
        <GradientStop Offset="1" Color="#FF0A1017" />
    </LinearGradientBrush>

</ResourceDictionary>
