<UserControl x:Class="KCTools.Views.AdbView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KCTools.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Padding="22,18,14,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="352" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,16,0">
                    <!-- Cihaz listesi -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="Bağlı Cihazlar" Style="{StaticResource T.CardTitle}" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding DeviceSummary}" Style="{StaticResource T.CardCaption}"
                                               Margin="0,0,10,0" />
                                    <Button Style="{StaticResource Btn.Ghost}" Content="Tara" FontSize="10.5"
                                            Padding="8,4" Command="{Binding ScanCommand}" />
                                </StackPanel>
                            </DockPanel>

                            <Border Style="{StaticResource Sep}" Margin="0,0,0,8" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="SERİ NO" Style="{StaticResource T.Section}" />
                                <TextBlock Grid.Column="1" Text="MODEL" Style="{StaticResource T.Section}" />
                                <TextBlock Grid.Column="2" Text="DURUM" Style="{StaticResource T.Section}" />
                            </Grid>

                            <ListBox ItemsSource="{Binding Devices}" Background="Transparent" BorderThickness="0"
                                     MaxHeight="140">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border Background="Transparent" Padding="0,5">
                                                        <ContentPresenter />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Serial}" Style="{StaticResource T.Mono}"
                                                       Foreground="{StaticResource Brush.Text.Primary}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Model}"
                                                       Style="{StaticResource T.Value}" />
                                            <TextBlock Grid.Column="2" Text="{Binding StateLabel}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource T.Value}">
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Height="52" CornerRadius="9" Background="{StaticResource Brush.Bg.Field}"
                                    BorderBrush="{StaticResource Brush.Border.Soft}" BorderThickness="1"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Bağlı cihaz yok — USB hata ayıklamayı açıp RSA onayını kabul edin."
                                           Style="{StaticResource T.Hint}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Cihaz bilgisi -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="Cihaz Bilgisi" Style="{StaticResource T.CardTitle}" />
                                <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                           Text="getprop" Style="{StaticResource T.Mono}" FontSize="10"
                                           Foreground="{StaticResource Brush.Text.Dim}" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding InfoFields}"
                                          ItemTemplate="{StaticResource Tpl.DeviceField}" />
                        </StackPanel>
                    </Border>

                    <!-- ADB komutu -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="ADB Komutu" Style="{StaticResource T.CardTitle}" />
                            <TextBlock Text="Kabuk komutları canlı konsola yazılır."
                                       Style="{StaticResource T.CardCaption}" Margin="0,3,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource Input.Text}"
                                         Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Style="{StaticResource Btn.Secondary}" Content="Gönder"
                                        Margin="10,0,0,0" Command="{Binding SendCommand}" />
                            </Grid>
                            <TextBlock Style="{StaticResource T.Hint}" Margin="0,10,0,0"
                                       Text="Örnek: shell dumpsys battery  ·  devices -l  ·  pull /sdcard/DCIM" />
                        </StackPanel>
                    </Border>

                    <!-- Araçlar -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="ADB Araçları" Style="{StaticResource T.CardTitle}" />
                            <TextBlock Text="Paket, dosya ve kabuk işlemleri"
                                       Style="{StaticResource T.CardCaption}" Margin="0,3,0,14" />
                            <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource Tpl.ActionTile}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <controls:OperationStatusCard />

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="ADB Notları" Style="{StaticResource T.CardTitle}" Margin="0,0,0,12" />
                            <DockPanel Margin="0,0,0,9">
                                <Border Width="4" Height="4" CornerRadius="2" DockPanel.Dock="Left"
                                        Background="{StaticResource Brush.Accent}" VerticalAlignment="Center"
                                        Margin="0,0,9,0" />
                                <TextBlock Style="{StaticResource T.Hint}"
                                           Text="Yetkisiz cihaz görünüyorsa telefon ekranındaki RSA onayını kabul edin." />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,9">
                                <Border Width="4" Height="4" CornerRadius="2" DockPanel.Dock="Left"
                                        Background="{StaticResource Brush.Accent}" VerticalAlignment="Center"
                                        Margin="0,0,9,0" />
                                <TextBlock Style="{StaticResource T.Hint}"
                                           Text="Birden fazla cihaz bağlıyken ilk çevrimiçi cihaz seçilir (-s otomatik eklenir)." />
                            </DockPanel>
                            <DockPanel>
                                <Border Width="4" Height="4" CornerRadius="2" DockPanel.Dock="Left"
                                        Background="{StaticResource Brush.Warning}" VerticalAlignment="Center"
                                        Margin="0,0,9,0" />
                                <TextBlock Style="{StaticResource T.Hint}"
                                           Text="Uzun süren komutlar 60 saniye sonra zaman aşımına uğrar ve süreç sonlandırılır." />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </ScrollViewer>
</UserControl>
