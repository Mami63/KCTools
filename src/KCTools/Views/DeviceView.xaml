<UserControl x:Class="KCTools.Views.DeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KCTools.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Padding="22,18,14,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="352" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,16,0">
                    <!-- Eşleşen model -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Katalog"
                                        Style="{StaticResource Btn.Ghost}" FontSize="10.5" Padding="9,4"
                                        Command="{Binding CatalogCommand}" />
                                <TextBlock Text="Eşleşen Model" Style="{StaticResource T.CardTitle}" />
                            </DockPanel>

                            <TextBlock Text="{Binding MatchTitle}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text.Primary}" TextWrapping="Wrap" />
                            <DockPanel Margin="0,4,0,0">
                                <TextBlock Text="{Binding MatchConfidence}" Style="{StaticResource T.Hint}"
                                           VerticalAlignment="Center" />
                                <Border DockPanel.Dock="Right" CornerRadius="10" Padding="7,2" Margin="10,0,0,0"
                                        Background="{StaticResource Brush.Bg.Field}">
                                    <TextBlock FontSize="8.5" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
                                                <Setter Property="Text" Value="TEST EDİLMEDİ" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MatchTested}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                                                        <Setter Property="Text" Value="TEST EDİLDİ" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DockPanel>
                            <TextBlock Text="{Binding MatchDetail}" Style="{StaticResource T.Hint}" Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Cihaz bilgisi -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                                        Content="Bilgileri Yenile" Style="{StaticResource Btn.Ghost}"
                                        FontSize="10.5" Padding="9,4"
                                        Command="{Binding RefreshInfoCommand}" />
                                <StackPanel>
                                    <TextBlock Text="Cihaz Bilgisi" Style="{StaticResource T.CardTitle}" />
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource T.CardCaption}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding Fields}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource T.Hint}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                       Style="{StaticResource T.Value}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Telefon bağlandığında bilgiler otomatik gelir; ADB yetkisi gerekir."
                                       Margin="0,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource T.Hint}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasInfo}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- İşlem kategorileri -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Cihaz İşlemleri" Style="{StaticResource T.CardTitle}" />
                            <TextBlock Text="Bağlı telefona uygulanacak işlemler — kategoriye göre seçin"
                                       Style="{StaticResource T.CardCaption}" Margin="0,3,0,10" />

                            <ItemsControl ItemsSource="{Binding ActionsView}"
                                          ItemTemplate="{StaticResource Tpl.ActionTile}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="Bold"
                                                           Margin="2,10,0,8"
                                                           Foreground="{StaticResource Brush.Text.Muted}" />
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- İmaj flash -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="İmaj Flash" Style="{StaticResource T.CardTitle}" />
                            <TextBlock Text="Fastboot ile seçilen bölüme imaj yaz"
                                       Style="{StaticResource T.CardCaption}" Margin="0,3,0,12" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Style="{StaticResource Input.Combo}"
                                          ItemsSource="{Binding Partitions}"
                                          SelectedItem="{Binding Partition, Mode=TwoWay}" />
                                <Border Grid.Column="1" Margin="10,0,0,0" Background="{StaticResource Brush.Bg.Field}"
                                        BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1"
                                        CornerRadius="8" Height="38" Padding="12,0">
                                    <TextBlock Text="{Binding ImageName}" Style="{StaticResource T.Mono}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Border>
                                <Button Grid.Column="2" Style="{StaticResource Btn.Ghost}" Content="İmaj Seç"
                                        Margin="10,0,0,0" Command="{Binding PickImageCommand}" />
                            </Grid>

                            <Button Style="{StaticResource Btn.Primary}" Content="Flashla" Width="132"
                                    HorizontalAlignment="Left" Command="{Binding FlashImageCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <!-- İşlem geçmişi -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Kilidi Aç" Style="{StaticResource Btn.Ghost}"
                                            FontSize="10.5" Padding="9,4"
                                            Command="{Binding UnlockCommand}"
                                            ToolTip="Ekran şifresini girip telefonu ADB ile aç" />
                                    <Button Content="Temizle" Style="{StaticResource Btn.Ghost}"
                                            FontSize="10.5" Padding="9,4" Margin="6,0,0,0"
                                            Command="{Binding ClearActivitiesCommand}" />
                                </StackPanel>
                                <TextBlock Text="İşlem Geçmişi" Style="{StaticResource T.CardTitle}" />
                            </DockPanel>

                            <TextBlock Text="Telefona yapılan son işlemler" Style="{StaticResource T.CardCaption}"
                                       Margin="0,2,0,10" />

                            <TextBlock Text="Henüz işlem yok — bir işlem çalıştırın.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource T.Hint}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Activities.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ListBox ItemsSource="{Binding Activities}" MaxHeight="300"
                                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border Background="Transparent" Padding="0,2">
                                                        <ContentPresenter />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Width="7" Height="7" VerticalAlignment="Top" Margin="0,5,9,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource Brush.Text.Muted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Success">
                                                                <Setter Property="Fill" Value="{StaticResource Brush.Success}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                                <Setter Property="Fill" Value="{StaticResource Brush.Warning}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Error">
                                                                <Setter Property="Fill" Value="{StaticResource Brush.Danger}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Brush.Text.Primary}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Hint}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding TimeText}" Style="{StaticResource T.Mono}"
                                                       FontSize="9.5" Foreground="{StaticResource Brush.Text.Dim}"
                                                       VerticalAlignment="Top" Margin="8,2,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <controls:OperationStatusCard />

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Dikkat" Style="{StaticResource T.CardTitle}" Margin="0,0,0,12" />
                            <DockPanel Margin="0,0,0,9">
                                <Border Width="4" Height="4" CornerRadius="2" DockPanel.Dock="Left"
                                        Background="{StaticResource Brush.Warning}" VerticalAlignment="Center"
                                        Margin="0,0,9,0" />
                                <TextBlock Style="{StaticResource T.Hint}"
                                           Text="Veri silme, kilit açma ve flash işlemleri geri alınamaz; onay istenir ve tüm adımlar günlüğe yazılır." />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,9">
                                <Border Width="4" Height="4" CornerRadius="2" DockPanel.Dock="Left"
                                        Background="{StaticResource Brush.Accent}" VerticalAlignment="Center"
                                        Margin="0,0,9,0" />
                                <TextBlock Style="{StaticResource T.Hint}"
                                           Text="Format/flash için cihaz fastboot modunda; sideload için recovery/sideload modunda olmalı." />
                            </DockPanel>
                            <DockPanel>
                                <Border Width="4" Height="4" CornerRadius="2" DockPanel.Dock="Left"
                                        Background="{StaticResource Brush.Accent}" VerticalAlignment="Center"
                                        Margin="0,0,9,0" />
                                <TextBlock Style="{StaticResource T.Hint}"
                                           Text="Yedekler ve logcat Masaüstü\KCTools-Yedek altına yazılır." />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </ScrollViewer>
</UserControl>
