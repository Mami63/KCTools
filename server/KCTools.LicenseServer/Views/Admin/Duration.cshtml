@model System.Collections.Generic.IEnumerable<License>
@{
    ViewData["Title"] = "Lisans süresi";
}

<h1>Lisans süresi</h1>
<p class="sub">Bitiş tarihleri ve toplu uzatma</p>

<div class="panel">
    <table>
        <thead>
        <tr><th>Anahtar</th><th>Başlangıç</th><th>Bitiş</th><th>Kalan</th><th>Uzat</th></tr>
        </thead>
        <tbody>
        @foreach (var license in Model)
        {
            var days = (license.EndsAt - System.DateTimeOffset.UtcNow).Days;

            <tr>
                <td class="mono">@license.Key</td>
                <td>@license.StartsAt.ToString("yyyy-MM-dd")</td>
                <td>@license.EndsAt.ToString("yyyy-MM-dd")</td>
                <td>
                    @if (license.IsRevoked)
                    {
                        <span class="tag bad">iptal</span>
                    }
                    else if (days < 0)
                    {
                        <span class="tag bad">doldu</span>
                    }
                    else if (days <= 30)
                    {
                        <span class="tag warn">@days gün</span>
                    }
                    else
                    {
                        <span class="tag ok">@days gün</span>
                    }
                </td>
                <td>
                    <form method="post" asp-action="Extend" class="row" style="gap:4px">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Key" value="@license.Key" />
                        <input name="Days" type="number" value="30" min="1" style="width:80px;min-width:80px;padding:5px" />
                        <button type="submit" class="small">Ekle</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
