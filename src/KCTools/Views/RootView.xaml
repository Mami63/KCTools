<UserControl x:Class="KCTools.Views.RootView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KCTools.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Padding="22,18,14,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="352" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,16,0">
                    <!-- Durum -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Yenile" Style="{StaticResource Btn.Ghost}"
                                            FontSize="10.5" Padding="9,4" Command="{Binding RefreshCommand}" />
                                    <Button Content="Doğrula" Style="{StaticResource Btn.Ghost}"
                                            FontSize="10.5" Padding="9,4" Margin="6,0,0,0"
                                            Command="{Binding VerifyCommand}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Root Durumu" Style="{StaticResource T.CardTitle}" />
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource T.CardCaption}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>

                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Model" Style="{StaticResource T.Hint}" />
                                <TextBlock Grid.Column="1" Text="{Binding ModelText}" Style="{StaticResource T.Value}" />
                            </Grid>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Seri No" Style="{StaticResource T.Hint}" />
                                <TextBlock Grid.Column="1" Text="{Binding SerialText}" Style="{StaticResource T.Mono}" />
                            </Grid>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Bootloader" Style="{StaticResource T.Hint}" />
                                <TextBlock Grid.Column="1" Text="{Binding BootloaderText}" Style="{StaticResource T.Value}" />
                            </Grid>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Root" Style="{StaticResource T.Hint}" />
                                <TextBlock Grid.Column="1" Text="{Binding RootText}" Style="{StaticResource T.Value}" />
                            </Grid>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Magisk" Style="{StaticResource T.Hint}" />
                                <TextBlock Grid.Column="1" Text="{Binding MagiskText}" Style="{StaticResource T.Value}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Doğrulanmış" Style="{StaticResource T.Hint}" />
                                <TextBlock Grid.Column="1" Text="{Binding VerifiedText}" Style="{StaticResource T.Value}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Adımlar -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Root Adımları" Style="{StaticResource T.CardTitle}" />
                            <TextBlock Text="Yalnızca sahibi olduğunuz cihazda, resmi yöntemle"
                                       Style="{StaticResource T.CardCaption}" Margin="0,3,0,14" />

                            <DockPanel Margin="0,0,0,14">
                                <Button DockPanel.Dock="Right" Content="Kilidi Aç" Style="{StaticResource Btn.Primary}"
                                        Width="120" Command="{Binding UnlockCommand}" />
                                <StackPanel>
                                    <TextBlock Text="1 · Bootloader kilidini aç" Style="{StaticResource T.Value}" />
                                    <TextBlock Style="{StaticResource T.Hint}" TextWrapping="Wrap"
                                               Text="fastboot flashing unlock — tüm veriler silinir, garanti etkilenir." />
                                </StackPanel>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="Magisk Kur (tek tık)"
                                        Style="{StaticResource Btn.Primary}" Width="150"
                                        Command="{Binding InstallMagiskCommand}" />
                                <StackPanel>
                                    <TextBlock Text="2 · Magisk'i kur" Style="{StaticResource T.Value}" />
                                    <TextBlock Style="{StaticResource T.Hint}" TextWrapping="Wrap"
                                               Text="Resmi GitHub sürümü otomatik indirilir ve telefona kurulur; ayrıca APK indirmeniz gerekmez." />
                                </StackPanel>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,10">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="boot.img Seç" Style="{StaticResource Btn.Ghost}"
                                            FontSize="10.5" Padding="8,4" Command="{Binding PickImageCommand}" />
                                    <Button Content="Flash" Style="{StaticResource Btn.Primary}"
                                            FontSize="10.5" Margin="6,0,0,0" Command="{Binding FlashCommand}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="3 · Yamalı boot.img'yi yaz" Style="{StaticResource T.Value}" />
                                    <TextBlock Text="{Binding ImageName}" Style="{StaticResource T.Hint}" />
                                </StackPanel>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,10">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Magisk'i Kaldır" Style="{StaticResource Btn.Ghost}"
                                            FontSize="10.5" Padding="8,4" Command="{Binding UnrootCommand}" />
                                    <Button Content="Stok Seç" Style="{StaticResource Btn.Ghost}"
                                            FontSize="10.5" Padding="8,4" Margin="6,0,0,0"
                                            Command="{Binding PickStockCommand}" />                                    <Button Content="ZIP'ten Çıkar" Style="{StaticResource Btn.Ghost}"
                                            FontSize="10.5" Padding="8,4" Margin="6,0,0,0"
                                            Command="{Binding ExtractStockCommand}" />
                                    <Button Content="Stok Flashla" Style="{StaticResource Btn.Ghost}"
                                            FontSize="10.5" Padding="8,4" Margin="6,0,0,0"
                                            Command="{Binding RestoreBootCommand}" />
                                    <Button Content="Root'u Kaldır" Style="{StaticResource Btn.Primary}"
                                            FontSize="10.5" Padding="8,4" Margin="6,0,0,0"
                                            Command="{Binding RemoveRootCommand}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="4 · Root kaldır" Style="{StaticResource T.Value}" />
                                    <TextBlock Text="{Binding StockImageName}" Style="{StaticResource T.Hint}" />
                                    <TextBlock Style="{StaticResource T.Hint}" TextWrapping="Wrap"
                                               Text="Magisk'i Kaldır → uygulama silinir. Stok Seç + Stok Flashla → yamalı boot geri alınır (tam unroot)." />
                                </StackPanel>
                            </DockPanel>

                            <DockPanel>
                                <StackPanel>
                                    <TextBlock Text="5 · Doğrula" Style="{StaticResource T.Value}" />
                                    <TextBlock Style="{StaticResource T.Hint}" TextWrapping="Wrap"
                                               Text="Yeniden başlat → Magisk uygulamasından root durumunu kontrol et; 'Doğrula' ile su/Magisk yeniden okunur." />
                                </StackPanel>
                            </DockPanel>

                            <Border Style="{StaticResource Sep}" Margin="0,14,0,10" />
                            <TextBlock Style="{StaticResource T.Hint}" TextWrapping="Wrap"
                                       Text="Gerekli: açık bootloader + cihaza ait boot.img + Magisk APK. Uygulama exploitten yararlanmaz; yalnızca resmi fastboot ve adb komutlarını kullanır." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <controls:OperationStatusCard />

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Uyarılar" Style="{StaticResource T.CardTitle}" Margin="0,0,0,12" />
                            <DockPanel Margin="0,0,0,9">
                                <Border Width="4" Height="4" CornerRadius="2" DockPanel.Dock="Left"
                                        Background="{StaticResource Brush.Warning}" VerticalAlignment="Center"
                                        Margin="0,0,9,0" />
                                <TextBlock Style="{StaticResource T.Hint}"
                                           Text="Kilit açma verileri siler; yedek alın." />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,9">
                                <Border Width="4" Height="4" CornerRadius="2" DockPanel.Dock="Left"
                                        Background="{StaticResource Brush.Danger}" VerticalAlignment="Center"
                                        Margin="0,0,9,0" />
                                <TextBlock Style="{StaticResource T.Hint}"
                                           Text="Yanlış boot.img cihazı açılmaz hale getirebilir (bootloop)." />
                            </DockPanel>
                            <DockPanel>
                                <Border Width="4" Height="4" CornerRadius="2" DockPanel.Dock="Left"
                                        Background="{StaticResource Brush.Warning}" VerticalAlignment="Center"
                                        Margin="0,0,9,0" />
                                <TextBlock Style="{StaticResource T.Hint}"
                                           Text="Root, garanti ve bazı bankacılık/DRM uygulamalarını etkiler." />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </ScrollViewer>
</UserControl>
