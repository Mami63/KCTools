# KC Tools lisans sunucusu — üretim ortamı örneği
# Bu dosyayı .env olarak kopyalayın ve DEĞERLERİ DOLDURUN.
# Hiçbir gerçek parola/anahtar bu şablon dosyasına yazılmamalıdır.

ASPNETCORE_ENVIRONMENT=Production

# PostgreSQL (TLS zorunlu). SSL Mode=Require / VerifyCA / VerifyFull
KCTOOLS_DB_CONNECTION=Host=db.example.com;Port=5432;Database=kctools;Username=kctools_app;Password=CHANGE_ME;SSL Mode=VerifyFull

# En az 32 karakter, rastgele
KCTOOLS_JWT_SECRET=CHANGE_ME_32_BYTES_MINIMUM_RANDOM

# Admin API başlığı (X-Admin-Key); en az 32 karakter
KCTOOLS_ADMIN_KEY=CHANGE_ME_32_BYTES_MINIMUM_RANDOM

# Offline yetki özel anahtarı: uygulama içerik kökü DIŞINDA olmalı
KCTOOLS_OFFLINE_KEY_PATH=/var/lib/kctools/offline-key.pem

# 1-168 arası; varsayılan 72
KCTOOLS_OFFLINE_HOURS=72

# HTTPS (KCTOOLS_LICENSE_HTTP tanımlanmamalı)
KCTOOLS_LICENSE_PORT=5443

# Yalnızca ilk kurulumda; kurulumdan sonra kaldırın
# KCTOOLS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# KCTOOLS_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_MIN_12_CHARS

# Otomatik migration üretimde önerilmez; CI/CD ile uygulanır
# KCTOOLS_DB_AUTO_MIGRATE=0
