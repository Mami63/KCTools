<UserControl x:Class="KCTools.Controls.OperationStatusCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource Card}">
        <StackPanel>
            <DockPanel>
                <TextBlock Text="İşlem Durumu" Style="{StaticResource T.CardTitle}" />
                <Border DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                        CornerRadius="20" Padding="9,3">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource Brush.Bg.Field}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StateText}" Value="ÇALIŞIYOR">
                                    <Setter Property="Background" Value="{StaticResource Brush.Accent.Soft}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StateText}" Value="TAMAM">
                                    <Setter Property="Background" Value="#FF12301F" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StateText}" FontSize="9.5" FontWeight="Bold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StateText}" Value="ÇALIŞIYOR">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StateText}" Value="TAMAM">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </DockPanel>

            <TextBlock Text="{Binding StatusText}" Style="{StaticResource T.Body}"
                       MinHeight="34" Margin="0,12,0,0" />

            <ProgressBar Style="{StaticResource App.Progress}" Maximum="100" Minimum="0"
                         Value="{Binding Progress, Mode=OneWay}" Margin="0,14,0,0" />

            <Grid Margin="0,8,0,0">
                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource T.Mono}"
                           HorizontalAlignment="Left" />
                <TextBlock Text="adım günlüğü" FontSize="10.5" Foreground="{StaticResource Brush.Text.Dim}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <Border Style="{StaticResource Sep}" />

            <TextBlock Style="{StaticResource T.Hint}"
                       Text="Her adım alt konsola zaman damgasıyla yazılır. İşlem sürerken diğer modüller kilitlenmez." />
        </StackPanel>
    </Border>
</UserControl>
