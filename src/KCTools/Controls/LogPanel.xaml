<UserControl x:Class="KCTools.Controls.LogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Brush.Bg.Console}">

    <Border Background="{StaticResource Brush.Bg.Console}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <!-- Başlık / filtreler -->
            <Border Grid.Row="0" Background="{StaticResource Brush.Log.Header}"
                    BorderBrush="{StaticResource Brush.Border.Soft}" BorderThickness="0,0,0,1">
                <Grid Margin="14,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource Brush.Success}" VerticalAlignment="Center" />
                        <TextBlock Text="İŞLEM GÜNLÜĞÜ" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Text.Secondary}" Margin="9,0,0,0"
                                   VerticalAlignment="Center" />
                        <Border Style="{StaticResource Pill}" Background="{StaticResource Brush.Bg.Elevated}"
                                Padding="7,2" Margin="10,0,0,0">
                            <TextBlock Text="{Binding Entries.Count}" FontSize="10"
                                       Foreground="{StaticResource Brush.Text.Muted}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource Brush.Bg.Field}" CornerRadius="7" Padding="2"
                                BorderBrush="{StaticResource Brush.Border.Soft}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Seg.Toggle}" Content="TÜMÜ" Tag="All"
                                             GroupName="LogFilter" IsChecked="True" Checked="OnFilterChanged" />
                                <RadioButton Style="{StaticResource Seg.Toggle}" Content="BİLGİ" Tag="Info"
                                             GroupName="LogFilter" Checked="OnFilterChanged" />
                                <RadioButton Style="{StaticResource Seg.Toggle}" Content="UYARI" Tag="Warn"
                                             GroupName="LogFilter" Checked="OnFilterChanged" />
                                <RadioButton Style="{StaticResource Seg.Toggle}" Content="HATA" Tag="Error"
                                             GroupName="LogFilter" Checked="OnFilterChanged" />
                            </StackPanel>
                        </Border>

                        <Border Width="1" Height="16" Background="{StaticResource Brush.Border.Default}"
                                Margin="10,0" />

                        <Button Style="{StaticResource Btn.Ghost}" Content="Kopyala" FontSize="10.5"
                                Padding="8,4" Command="{Binding CopyCommand}" />
                        <Button Style="{StaticResource Btn.Ghost}" Content="Temizle" FontSize="10.5"
                                Padding="8,4" Command="{Binding ClearCommand}" />

                        <CheckBox Style="{StaticResource Switch}" Content="Oto" FontSize="10.5" Margin="10,0,0,0"
                                  IsChecked="{Binding AutoScroll, Mode=TwoWay}"
                                  ToolTip="Yeni satırlarda otomatik olarak en alta kaydır" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Konsol gövdesi -->
            <Border Grid.Row="1" Background="{StaticResource Brush.Bg.Console}" Padding="14,8,4,4">
                <ListBox x:Name="LogList" Style="{StaticResource Log.List}"
                         ItemTemplate="{StaticResource Tpl.LogLine}" />
            </Border>

            <!-- Alt bilgi satırı -->
            <Border Grid.Row="2" Background="{StaticResource Brush.Log.Header}"
                    BorderBrush="{StaticResource Brush.Border.Soft}" BorderThickness="0,1,0,0" Padding="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&gt;" FontFamily="{StaticResource Font.Mono}" FontSize="11"
                               Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center" />
                    <TextBlock Text="Günlük hazır — komutlar modül sayfalarından çalıştırılır."
                               FontFamily="{StaticResource Font.Mono}" FontSize="10.5"
                               Foreground="{StaticResource Brush.Text.Dim}" Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
